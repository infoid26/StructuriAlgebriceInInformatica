# Microsoft authentication
AUTH_ENABLED=false
AUTH_ORIGIN=https://course.example
AUTH_UNIVERSITY_TENANT_IDS=UNIVERSITY-TENANT-UUID
# WEBSITE_INSTANCE_ID and WEBSITE_AUTH_ENABLED are supplied by Azure App Service.

# PostgreSQL progress storage
PROGRESS_USE_AZURE_POSTGRESQL=true
AZURE_POSTGRESQL_HOST=DATABASE-HOST
AZURE_POSTGRESQL_PORT=5432
AZURE_POSTGRESQL_DATABASE=DATABASE-NAME
AZURE_POSTGRESQL_USER=DATABASE-USER
AZURE_POSTGRESQL_PASSWORD=DATABASE-PASSWORD
# PROGRESS_DATABASE_URL can be used instead, with verified TLS.